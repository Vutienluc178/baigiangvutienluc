{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL to the user's profile picture." },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"], "description": "User's role in the application." }
      },
      "required": ["uid", "email"]
    },
    "Matrix": {
      "title": "Matrix",
      "description": "Exam matrix configuration.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the matrix." },
        "rows": { "type": "array", "description": "List of matrix rows defining the structure." },
        "subject": { "type": "string", "description": "Subject of the exam." },
        "grade": { "type": "string", "description": "Grade level." },
        "authorUid": { "type": "string", "description": "UID of the user who created the matrix." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the matrix was created." }
      },
      "required": ["title", "rows", "subject", "grade", "authorUid", "createdAt"]
    },
    "BankItem": {
      "title": "BankItem",
      "description": "A saved exam, theory, or Polya presentation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID." },
        "title": { "type": "string", "description": "Title of the item." },
        "type": { "type": "string", "enum": ["exam", "matrix", "theory", "polya"], "description": "Type of content." },
        "subject": { "type": "string", "description": "Subject." },
        "grade": { "type": "string", "description": "Grade level (6-12)." },
        "authorUid": { "type": "string", "description": "UID of the author." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." },
        "data": { "type": "object", "description": "The full ExportData object." }
      },
      "required": ["id", "title", "type", "subject", "grade", "authorUid", "createdAt", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/matrices/{matrixId}": {
      "schema": "Matrix",
      "description": "Collection of saved exam matrices."
    },
    "/bank/{itemId}": {
      "schema": "BankItem",
      "description": "Collection of saved presentations and lectures."
    }
  }
}
